{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudenterpo.github.io/mimico/schemas/error.schema.json",
  "title": "ErrorResponse",
  "type": "object",
  "required": ["code", "message"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "correlationId": {
      "type": "string"
    }
  }
}
