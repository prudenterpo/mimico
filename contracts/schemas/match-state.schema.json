{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudenterpo.github.io/mimico/schemas/match-state.schema.json",
  "title": "MatchState",
  "type": "object",
  "required": [
    "matchId",
    "tableId",
    "matchStatus",
    "roundState",
    "players",
    "teamAPosition",
    "teamBPosition",
    "isPaused"
  ],
  "additionalProperties": false,
  "properties": {
    "matchId": {
      "type": "string",
      "format": "uuid"
    },
    "tableId": {
      "type": "string",
      "format": "uuid"
    },
    "matchStatus": {
      "type": "string",
      "enum": ["MATCH_SETUP", "MATCH_ACTIVE", "MATCH_PAUSED", "MATCH_FINISHED"]
    },
    "roundState": {
      "type": ["string", "null"],
      "enum": [
        "ROUND_WAITING_FOR_DICE",
        "ROUND_WAITING_FOR_WORD_SELECTION",
        "ROUND_GUESSING",
        "ROUND_RESOLVED",
        null
      ]
    },
    "players": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["userId", "nickname", "team", "playerOrder"],
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          },
          "team": {
            "type": "string",
            "enum": ["A", "B"]
          },
          "playerOrder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    },
    "teamAPosition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 52
    },
    "teamBPosition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 52
    },
    "currentTeam": {
      "type": ["string", "null"],
      "enum": ["A", "B", null]
    },
    "currentMimePlayerId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "timerEndsAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "isSpecialTile": {
      "type": "boolean"
    },
    "isPaused": {
      "type": "boolean"
    },
    "pausedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "disconnectedUserId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "remainingRoundSecondsOnPause": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 60
    }
  }
}
