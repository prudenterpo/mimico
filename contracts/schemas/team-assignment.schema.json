{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudenterpo.github.io/mimico/schemas/team-assignment.schema.json",
  "title": "TeamAssignment",
  "type": "object",
  "required": ["team", "playerIds"],
  "additionalProperties": false,
  "properties": {
    "team": {
      "type": "string",
      "enum": ["A", "B"]
    },
    "playerIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
